{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Streamlit: iniciar preview",
      "type": "shell",
      "command": "${env:LOCALAPPDATA}\\Programs\\Python\\Python311\\python.exe",
      "args": [
        "-m",
        "streamlit",
